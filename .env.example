NODE_ENV=development
# Set NODE_ENV=production in Render to require HTTPS, secure cookies and the Supabase pooler.
PORT=3001
# Exact browser origin; set this to the Render HTTPS URL in production.
APP_ORIGIN=http://localhost:5173
PG_POOL_MAX=5
# For Render, use Supabase's Transaction Pooler URI (port 6543, IPv4 compatible),
# not the direct database URI. Copy the full URI from Supabase > Connect.
# URL-encode special characters in the database password.
DATABASE_URL=postgresql://postgres.project-ref:replace-with-url-encoded-password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
# Generate a random secret with: openssl rand -base64 48
SESSION_SECRET=replace-this-with-at-least-32-random-bytes
# Set to 1 when Render is the single trusted reverse proxy in front of this app.
TRUST_PROXY_HOPS=1
